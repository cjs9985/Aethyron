# ──────────────────────────────────────────────────────────────────────────────
# Aethyron environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# Groq cloud API key (https://console.groq.com/keys)
# When set, Aethyron uses Groq instead of local Ollama — much faster on CPU-only machines.
# Leave blank or remove to fall back to local Ollama.
GROQ_API_KEY=your_groq_api_key_here
